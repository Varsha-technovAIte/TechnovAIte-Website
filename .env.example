# Enquiry form delivery (contact, Solvrr waitlist, careers).
# Configure at least one channel. In production, submissions are refused if none is set,
# so leads are never silently dropped.

# Email via Resend (https://resend.com). ENQUIRY_FROM must use a domain verified in Resend.
RESEND_API_KEY=
ENQUIRY_FROM="TechnovAIte Website <website@technovaite.com>"
# Comma-separated recipients. Defaults to the contact email in src/lib/site.ts.
ENQUIRY_TO=adarsh.a@technovaite.com

# Optional: POST each submission as JSON to a CRM / Zapier / Make / HubSpot webhook.
ENQUIRY_WEBHOOK_URL=
